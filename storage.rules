rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Users can only access their own files
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Size limit: 50MB
    match /{allPaths=**} {
      allow write: if request.resource.size < 50 * 1024 * 1024;
    }
  }
}
