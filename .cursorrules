## FIREBASE INTEGRATION (PRODUCTION READY)
## ═══════════════════════════════════════════════════════════════

### Firebase Setup
```swift
// AppDelegate or @main App
import Firebase
import FirebaseFirestore
import FirebaseAuth
import FirebaseStorage
import FirebaseCrashlytics
import FirebaseAnalytics

@main
struct PitchMeApp: App {
    init() {
        FirebaseApp.configure()
        
        // Enable offline persistence
        let settings = FirestoreSettings()
        settings.isPersistenceEnabled = true
        Firestore.firestore().settings = settings
    }
}
```

### Firestore Collection Structure
```
users/{userId}
  ├── email: String
  ├── subscription: String (free, pro, enterprise)
  ├── createdAt: Timestamp
  └── decks (subcollection)
      └── {deckId}
          ├── title: String
          ├── useCase: String
          ├── themeId: String
          ├── storyScore: Int?
          ├── createdAt: Timestamp
          ├── updatedAt: Timestamp
          └── slides (subcollection)
              └── {slideId}
                  ├── index: Int
                  ├── layoutType: String
                  ├── title: String
                  ├── bullets: [String]
                  ├── speakerNotes: String?
                  └── createdAt: Timestamp

exports/{exportId}
  ├── userId: String
  ├── deckId: String
  ├── format: String (pdf, pptx, google_slides)
  ├── status: String (queued, processing, done, failed)
  ├── fileUrl: String?
  └── createdAt: Timestamp

uploads/{uploadId}
  ├── userId: String
  ├── fileName: String
  ├── fileSize: Int
  ├── status: String
  └── analysisResult: Map
```

### Firestore Security Rules (COPY TO FIREBASE CONSOLE)
```javascript
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Users can only access their own data
    match /users/{userId} {
      allow read, write: if isOwner(userId);
      
      match /decks/{deckId} {
        allow read, write: if isOwner(userId);
        
        match /slides/{slideId} {
          allow read, write: if isOwner(userId);
        }
      }
    }
    
    // Exports - user can only read their own
    match /exports/{exportId} {
      allow read: if isAuthenticated() && 
                     resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && 
                       request.resource.data.userId == request.auth.uid;
    }
    
    // Uploads - user can only access their own
    match /uploads/{uploadId} {
      allow read, write: if isAuthenticated() && 
                            resource.data.userId == request.auth.uid;
    }
  }
}
```

### Storage Security Rules
```javascript
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Users can only access their own files
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && 
                           request.auth.uid == userId;
    }
    
    // Size limit: 50MB
    match /{allPaths=**} {
      allow write: if request.resource.size < 50 * 1024 * 1024;
    }
  }
}
```

## ═══════════════════════════════════════════════════════════════
## VERTEX AI + GEMINI 2.0 INTEGRATION
## ═══════════════════════════════════════════════════════════════

### Architecture: iOS → Cloud Functions → Vertex AI

**NEVER call Vertex AI directly from iOS**. Always use Cloud Functions.

### Cloud Function Example (TypeScript)

```typescript
// functions/src/generateDeck.ts
import * as functions from 'firebase-functions';
import { VertexAI } from '@google-cloud/vertexai';

const vertexAI = new VertexAI({
  project: 'your-project-id',
  location: 'us-central1'
});

export const generateDeck = functions.https.onCall(async (data, context) => {
  // Authenticate
  if (!context.auth) {
    throw new functions.https.HttpsError('unauthenticated', 'Must be logged in');
  }
  
  // Check subscription
  const userDoc = await admin.firestore()
    .collection('users')
    .doc(context.auth.uid)
    .get();
    
  const subscription = userDoc.data()?.subscription || 'free';
  
  // Free tier limits
  if (subscription === 'free') {
    const decksThisMonth = await getDecksCreatedThisMonth(context.auth.uid);
    if (decksThisMonth >= 3) {
      throw new functions.https.HttpsError(
        'resource-exhausted',
        'Monthly deck limit reached. Upgrade to Pro.'
      );
    }
  }
  
  const { wizardState } = data;
  
  // Call Gemini 2.0 Flash
  const model = vertexAI.getGenerativeModel({
    model: 'gemini-2.0-flash',
    systemInstruction: ELITE_DECK_GENERATION_PROMPT
  });
  
  const result = await model.generateContent({
    contents: [{
      role: 'user',
      parts: [{ text: JSON.stringify(wizardState) }]
    }],
    generationConfig: {
      temperature: 0.7,
      maxOutputTokens: 4096,
      responseMimeType: 'application/json'
    }
  });
  
  const deckData = JSON.parse(result.response.text());
  
  // Save to Firestore
  const deckRef = await admin.firestore()
    .collection('users')
    .doc(context.auth.uid)
    .collection('decks')
    .add({
      ...deckData,
      createdAt: admin.firestore.FieldValue.serverTimestamp(),
      updatedAt: admin.firestore.FieldValue.serverTimestamp()
    });
  
  // Track usage
  await admin.firestore()
    .collection('users')
    .doc(context.auth.uid)
    .update({
      decksCreatedThisMonth: admin.firestore.FieldValue.increment(1)
    });
  
  return { deckId: deckRef.id };
});

const ELITE_DECK_GENERATION_PROMPT = `
You are an elite pitch deck consultant who has helped 1000+ startups raise funding.

Generate a professional, investor-ready pitch deck optimized for the specified use case.

INPUT: JSON with startup information
OUTPUT: JSON with 10-12 slides

Slide structure:
- Title slide (company name + one-liner)
- Problem (WHO has it, HOW painful, quantify)
- Solution (WHAT you built, WHY 10X better)
- Market (TAM/SAM/SOM, growth rate)
- Product (demo/screenshots if possible)
- Business Model (revenue streams, unit economics)
- Traction (metrics, growth, momentum)
- Competition (your moat/differentiation)
- Team (credentials, why you'll win)
- Roadmap (next 12-24 months)
- Ask (if investor deck: funding amount + use of funds)

Make it compelling, concise, and story-driven.
Include speaker notes with presentation tips.
`;
```

### iOS Service

```swift
final class DeckGenerationService {
    static let shared = DeckGenerationService()
    
    func generateDeck(from state: WizardState) async throws -> String {
        guard let currentUser = Auth.auth().currentUser else {
            throw DeckGenerationError.notAuthenticated
        }
        
        let callable = Functions.functions().httpsCallable("generateDeck")
        
        let data: [String: Any] = [
            "wizardState": state.toDictionary()
        ]
        
        do {
            let result = try await callable.call(data)
            guard let deckId = result.data as? String else {
                throw DeckGenerationError.invalidResponse
            }
            return deckId
        } catch let error as NSError {
            if error.domain == "FunctionsErrorDomain" {
                // Handle specific function errors
                throw mapFirebaseFunctionError(error)
            }
            throw error
        }
    }
}
```

